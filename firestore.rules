rules_version = '2';

// ===============================================================
// 想定データモデル（スキーマ定義）
// ===============================================================
//
// コレクション: users/{userId}
//   - isStudentVerified: bool (必須・サーバー管理。create時はfalse固定、update不可)
//   - createdAt: timestamp (任意・create時のみ設定可、update不可)
//   - verifiedAt: timestamp (任意・サーバー管理、クライアント書き込み不可)
//   - name: string | null (任意・新規/変更時は0〜100文字、未変更の既存レガシー値は維持可)
//   - faculty: string | null (任意・新規/変更時は0〜100文字、未変更の既存レガシー値は維持可)
//   - grade: int | null (任意・新規/変更時は1〜10、未変更の既存レガシー値は維持可)
//   - mainCampus: string | null (任意・新規/変更時は 'imadegawa' | 'kyotanabe' | 'both'、未変更の既存レガシー値は維持可)
//   - interests: list<string> | null (任意・新規/変更時は最大20件・空文字不可・各要素1〜100文字・合計1000文字以内、未変更の既存レガシー値は維持可)
//   - iconUrl: string | null (任意・新規/変更時は本人の users/{userId}/icon|photos Storage URLのみ、既存レガシー値は維持可)
//   - photoUrls: list<string> | null (任意・最大6件、新規/変更要素は本人の users/{userId}/icon|photos Storage URLのみ、既存レガシー要素は維持可)
//
// サブコレクション: users/{userId}/private/{docId}
//   - サーバー（Admin SDK）専用。管理者のreadのみ許可、クライアントwrite完全禁止
//
// サブコレクション: users/{userId}/blocks/{blockedId}
//   - targetName: string (任意・最大1000文字、レガシー長文名の相手もブロック可)
//   - createdAt: timestamp (任意)
//
// コレクション: organizations/{docId} (docId == 代表者UID)
//   - id: string | null (任意・docIdと一致、update時は既存値維持可)
//   - name: string (必須・新規/変更時は1〜100文字、update時は未変更または前後空白除去一致の既存レガシー値維持可)
//   - description: string | null (任意・新規/変更時は0〜2000文字、update時は未変更または前後空白除去一致の既存レガシー値維持可)
//   - categories: list<string> | null (任意・新規/変更時は最大25件・OrgCategory列挙値のみ、update時は未変更の既存値維持可)
//   - campus: string | null (任意・新規/変更時は 'imadegawa' | 'kyotanabe' | 'both'、update時は未変更の既存値維持可)
//   - logoEmoji: string | null (任意・新規/変更時は最大20文字、update時は未変更の既存値維持可)
//   - instagramUrl: string | null (任意・新規/変更時は空文字/@ハンドル/instagram.comドメインのみ、update時は未変更または前後空白除去一致の既存レガシー値維持可)
//   - groupLineUrl: string | null (任意・新規/変更時は空文字または https://(www.|page.|liff.|openchat.)?line.me/ / https://lin.ee/ のみ、update時は未変更または前後空白除去一致の既存レガシー値維持可)
//   - logoUrl: string | null (任意・新規/変更時は自団体の organizations/{docId}/logo|photos Storage URLのみ、既存レガシー値は維持可)
//   - proofImageUrl: string | null (任意・新規/変更時は自団体の organizations/{docId}/proof|photos Storage URLのみ、既存レガシー値は維持可)
//   - photoUrls: list<string> | null (任意・最大6件、新規/変更要素は自団体の organizations/{docId}/photos|logo Storage URLのみ、既存レガシー要素は維持可)
//   - representativeId: string (必須・作成者UID固定、変更不可)
//   - status: string (必須・create時は'pending'固定、管理者のみ変更可)
//   - isOfficial: bool | null (任意・create時はfalse固定、オーナー変更不可)
//   - verifiedAt: timestamp | string | null (サーバー/管理者管理、オーナーは未設定↔null差分以外変更不可)
//   - createdAt: timestamp | ISO8601 string | null (任意・pending申請時の正規日時上書きを除きオーナー変更不可、未変更の既存レガシー文字列は維持可)
//
// サブコレクション: organizations/{docId}/blocks/{blockedId}
//   - targetName: string (任意・最大1000文字、レガシー長文名の相手もブロック可)
//   - createdAt: timestamp (任意)
//
// コレクション: events/{eventId}
//   - organizationId: string (必須・主催団体UID固定、変更不可)
//   - organizationName: string (任意・自団体名と一致、または更新時は既存値/'Unknown'維持可)
//   - organizationEmoji: string | null (任意・最大20文字、または自団体登録値/既存値維持可)
//   - organizationCategory: string | null (任意・最大30文字、update時は既存値維持可)
//   - categories: list<string> | null (任意・後方互換)
//   - title: string (必須・新規/変更時は1〜100文字、update時は未変更の既存値維持可)
//   - description: string | null (任意・新規/変更時は0〜5000文字、update時は未変更の既存値維持可)
//   - startAt: timestamp (必須・create時は現在以降、update時は過去日時への巻き戻し不可・秒丸め許容)
//   - campus: string | null (任意・新規/変更時は 'imadegawa' | 'kyotanabe' | 'both'、update時は未変更の既存値維持可)
//   - organizationLogoUrl: string | null (任意・自団体の Storage URL または自団体に登録済みの logoUrl 転記値のみ)
//   - fee: string | null (任意・新規/変更時は最大200文字、update時は既存値維持可)
//   - capacity: string | null (任意・新規/変更時は最大200文字、update時は既存値維持可)
//   - location: string | null (任意・新規/変更時は最大500文字、update時は既存値維持可)
//   - groupLineUrl: string | null (任意・新規/変更時は https://(www.|page.|liff.|openchat.)?line.me/ または https://lin.ee/ のみ、update時は未変更の既存レガシー値維持可)
//   - createdAt / updatedAt: timestamp | null (任意・update時は過去文字列createdAtも維持可)
//
// サブコレクション: events/{eventId}/applications/{applicationId} (applicationId == studentId)
//   - studentId: string (必須・申込学生UID)
//   - studentName: string (必須・1〜100文字、または本人の登録値転記は維持可)
//   - studentFaculty: string (必須・1〜100文字、または本人の登録値転記は維持可)
//   - studentGrade: int (必須・1〜10、または本人の登録値転記は維持可)
//   - studentIconUrl: string | null (任意・本人の Storage URL または本人に登録済みの iconUrl 転記値のみ)
//   - status: string (申込ステータス: 'applied' | 'accepted' | 'rejected')
//   - appliedAt / respondedAt: timestamp (申込日時・承認却下応答日時)
//
// コレクション: scouts/{docId}
//   - 定型文テンプレートID(0〜4)＋検証済み埋め込み値＋送信元団体・対象学生の登録データ（名前・絵文字・SNS URL・ロゴ/アイコンURL）完全一致強制
//
// コレクション: reports/{reportId}
//   - 通報データ（ホワイトリスト・文字数制限・レガシー/悪質データ通報を妨げないsnapshot制限）
//
// コレクション: contacts/{docId}
//   - userId, category, message(1〜2000文字), status('open'), createdAt(timestamp)
//
// コレクション: tags/{docId}
//   - name(1〜100文字), createdAt(timestamp)
//
// サーバー専用コレクション: university_email_locks, _account_deletions, _admin_alert_rate_limits, admin_notifications
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // 共通ヘルパー関数（認証・ロール判定）
    // ==========================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.get('admin', false) == true;
    }

    // 学生の第2層認証（大学メール確認コード検証）が完了しているかチェック
    function isVerifiedStudent() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isStudentVerified', false) == true;
    }

    // 団体アカウント（審査中・却下・停止中・承認済みすべて含む）が存在するかチェック
    function isOrgAccount() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(request.auth.uid));
    }

    // 呼び出し元の団体が審査承認済みかチェック
    function isVerifiedOrg() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.get('status', '') == 'verified';
    }

    // ==========================================================
    // 共通バリデーション関数（Storage パススコープ・URL・配列・列挙値）
    // ※Firestore の 1,000式評価上限を確実に下回るよう、単一正規表現と集合演算で最小式数に最適化
    // ==========================================================

    // 学生本人の Storage フォルダ（users/{userId}/icon|photos/{fileName}）配下の画像URL検証
    // ※オブジェクト名部分への生スラッシュ '/' や '%2F' 混入によるサブ階層・別パス偽装も遮断する
    function isScopedUserStorageUrlPattern(url, userId) {
      return url.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/d-scout-6d281\\.(firebasestorage\\.app|appspot\\.com)/o/users%2F' + userId + '%2F(icon|photos)%2F[a-zA-Z0-9._~%!$&\'()*+,;=:@-]+(\\?[a-zA-Z0-9._~%!$&\'()*+,;=:@/?-]*)?$')
        && !url.matches('(?i)^https://[^?]*%2f(icon|photos)%2f[^?]*%2f.*');
    }

    function isScopedUserImageUrl(url, userId) {
      return url is string
        && url.size() <= 2048
        && (
          url == ''
          || (userId.matches('^[a-zA-Z0-9_-]{1,128}$') && isScopedUserStorageUrlPattern(url, userId))
        );
    }

    function isValidStringPhotoArray(urls) {
      return urls is list
        && urls.size() <= 6
        && (urls.size() < 1 || (urls[0] is string && urls[0].size() <= 2048))
        && (urls.size() < 2 || (urls[1] is string && urls[1].size() <= 2048))
        && (urls.size() < 3 || (urls[2] is string && urls[2].size() <= 2048))
        && (urls.size() < 4 || (urls[3] is string && urls[3].size() <= 2048))
        && (urls.size() < 5 || (urls[4] is string && urls[4].size() <= 2048))
        && (urls.size() < 6 || (urls[5] is string && urls[5].size() <= 2048));
    }

    function areAllScopedUserPhotoUrls(urls, userId) {
      return urls.size() == 0
        || (
          urls.join('\n').matches('^https://firebasestorage\\.googleapis\\.com/v0/b/d-scout-6d281\\.(firebasestorage\\.app|appspot\\.com)/o/users%2F' + userId + '%2F(icon|photos)%2F[a-zA-Z0-9._~%!$&\'()*+,;=:@-]+(\\?[a-zA-Z0-9._~%!$&\'()*+,;=:@/?-]*)?(\nhttps://firebasestorage\\.googleapis\\.com/v0/b/d-scout-6d281\\.(firebasestorage\\.app|appspot\\.com)/o/users%2F' + userId + '%2F(icon|photos)%2F[a-zA-Z0-9._~%!$&\'()*+,;=:@-]+(\\?[a-zA-Z0-9._~%!$&\'()*+,;=:@/?-]*)?)*$')
          && !urls.join('\n').matches('(?is).*https://[^?\n]*%2f(icon|photos)%2f[^?\n]*%2f.*')
        );
    }

    function isValidUserPhotoUrlListOnUpdate(urls, userId) {
      return isValidStringPhotoArray(urls)
        && userId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && areAllScopedUserPhotoUrls(
          resource.data.get('photoUrls', null) is list ? urls.removeAll(resource.data.photoUrls) : urls,
          userId
        );
    }

    // 団体自身の Storage フォルダ（organizations/{orgId}/photos|logo|proof/{fileName}）配下の画像URL検証
    function isScopedOrgPhotoOrLogoPattern(url, orgId) {
      return url.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/d-scout-6d281\\.(firebasestorage\\.app|appspot\\.com)/o/organizations%2F' + orgId + '%2F(photos|logo)%2F[a-zA-Z0-9._~%!$&\'()*+,;=:@-]+(\\?[a-zA-Z0-9._~%!$&\'()*+,;=:@/?-]*)?$')
        && !url.matches('(?i)^https://[^?]*%2f(photos|logo)%2f[^?]*%2f.*');
    }

    function isScopedOrgProofOrPhotoPattern(url, orgId) {
      return url.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/d-scout-6d281\\.(firebasestorage\\.app|appspot\\.com)/o/organizations%2F' + orgId + '%2F(proof|photos)%2F[a-zA-Z0-9._~%!$&\'()*+,;=:@-]+(\\?[a-zA-Z0-9._~%!$&\'()*+,;=:@/?-]*)?$')
        && !url.matches('(?i)^https://[^?]*%2f(proof|photos)%2f[^?]*%2f.*');
    }

    function isScopedOrgLogoUrl(url, orgId) {
      return url is string
        && url.size() <= 2048
        && (
          url == ''
          || (orgId.matches('^[a-zA-Z0-9_-]{1,128}$') && isScopedOrgPhotoOrLogoPattern(url, orgId))
        );
    }

    function isScopedOrgProofUrl(url, orgId) {
      return url is string
        && url.size() <= 2048
        && (
          url == ''
          || (orgId.matches('^[a-zA-Z0-9_-]{1,128}$') && isScopedOrgProofOrPhotoPattern(url, orgId))
        );
    }

    function areAllScopedOrgPhotoUrls(urls, orgId) {
      return urls.size() == 0
        || (
          urls.join('\n').matches('^https://firebasestorage\\.googleapis\\.com/v0/b/d-scout-6d281\\.(firebasestorage\\.app|appspot\\.com)/o/organizations%2F' + orgId + '%2F(photos|logo)%2F[a-zA-Z0-9._~%!$&\'()*+,;=:@-]+(\\?[a-zA-Z0-9._~%!$&\'()*+,;=:@/?-]*)?(\nhttps://firebasestorage\\.googleapis\\.com/v0/b/d-scout-6d281\\.(firebasestorage\\.app|appspot\\.com)/o/organizations%2F' + orgId + '%2F(photos|logo)%2F[a-zA-Z0-9._~%!$&\'()*+,;=:@-]+(\\?[a-zA-Z0-9._~%!$&\'()*+,;=:@/?-]*)?)*$')
          && !urls.join('\n').matches('(?is).*https://[^?\n]*%2f(photos|logo)%2f[^?\n]*%2f.*')
        );
    }

    function isScopedOrgPhotoUrlList(urls, orgId) {
      return isValidStringPhotoArray(urls)
        && orgId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && areAllScopedOrgPhotoUrls(urls, orgId);
    }

    function isValidOrgPhotoUrlListOnUpdate(urls, orgId) {
      return isValidStringPhotoArray(urls)
        && orgId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && areAllScopedOrgPhotoUrls(
          resource.data.get('photoUrls', null) is list ? urls.removeAll(resource.data.photoUrls) : urls,
          orgId
        );
    }

    // Instagram入力の検証（空文字、@ユーザー名、ユーザー名のみ、instagram.com URLのみ許可）
    // ※ScoutDetailScreen._handleContact が 'instagram.com' を含む文字列に 'https://' を付与して
    //   そのまま開く仕様のため、ハンドル分岐側で 'instagram.com' 部分一致（instagram.com.evil.cc等）を明示排除する
    // ※パス部には '@username' 表記も許容し、ホスト部の大文字小文字混在（iOS先頭自動大文字化等）も吸収しつつ、
    //   ホスト直後は行末または '/' '?' '#' に固定して userinfo・サブドメイン・バックスラッシュ偽装を遮断する
    function isValidInstagramUrl(url) {
      return url is string
        && url.size() <= 500
        && (
          url == ''
          || (!url.matches('(?i).*instagram\\.com.*') && url.matches('^@?[a-zA-Z0-9._]{1,30}/?$'))
          || url.matches('(?i)^(https?://)?(www\\.|m\\.)?instagram\\.com([/?#][a-zA-Z0-9._@/?=&%+#~:,!-]*)?$')
        );
    }

    // グループLINE招待・オープンチャット・公式LINE（line.me / www.line.me / page.line.me / liff.line.me / openchat.line.me / lin.ee）URLの検証
    function isValidGroupLineUrl(url) {
      return url is string
        && url.size() <= 500
        && (
          url == ''
          || url.matches('(?i)^https://((www\\.|page\\.|liff\\.|openchat\\.)?line\\.me|lin\\.ee)/[a-zA-Z0-9._~@/?=&%+#:,!-]+$')
        );
    }

    function isValidCampus(campus) {
      return campus in ['imadegawa', 'kyotanabe', 'both'];
    }

    function isValidOrgCategoryList(categories) {
      return categories is list
        && categories.size() <= 25
        && categories.hasOnly([
          'all', 'sports', 'culture', 'academic', 'volunteer',
          'music', 'varsity', 'tennis', 'event', 'sportsCircle',
          'it', 'international', 'beginner', 'competitive', 'enjoy',
          'joint', 'intercollege', 'homey', 'large', 'female', 'male'
        ]);
    }

    // 興味タグ配列の要素型（string）・空文字禁止・各要素100文字以下・合計1000文字以下を最小式数で検証（最大20件）
    function isValidInterestList(items) {
      return items is list
        && items.size() <= 20
        && !('' in items)
        && (items.size() < 1 || items[0] is string)
        && (items.size() < 2 || items[1] is string)
        && (items.size() < 3 || items[2] is string)
        && (items.size() < 4 || items[3] is string)
        && (items.size() < 5 || items[4] is string)
        && (items.size() < 6 || items[5] is string)
        && (items.size() < 7 || items[6] is string)
        && (items.size() < 8 || items[7] is string)
        && (items.size() < 9 || items[8] is string)
        && (items.size() < 10 || items[9] is string)
        && (items.size() < 11 || items[10] is string)
        && (items.size() < 12 || items[11] is string)
        && (items.size() < 13 || items[12] is string)
        && (items.size() < 14 || items[13] is string)
        && (items.size() < 15 || items[14] is string)
        && (items.size() < 16 || items[15] is string)
        && (items.size() < 17 || items[16] is string)
        && (items.size() < 18 || items[17] is string)
        && (items.size() < 19 || items[18] is string)
        && (items.size() < 20 || items[19] is string)
        && items.join('').size() <= 1000
        && !items.join('\n').matches('(?s).*[^\n]{101,}.*');
    }

    // update 時に既存値から変更がない（未設定↔null含む）ことを最小式数で判定するヘルパー
    function isUnchangedField(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // クライアント保存時の自動 .trim() により、既存の前後空白付きレガシー文字列が
    // 「値変更」と誤判定されてデッドロックするのを最小式数（let多重展開なし）で防ぐヘルパー
    function isTrimmedPrev(val, prev) {
      return val is string && prev is string && val == prev.trim();
    }

    // Organization.fromFirestore → DateTime.parse が FormatException で管理画面をクラッシュさせないよう、
    // 文字列日時は厳格な ISO 8601 形式のみ許可するヘルパー（Poison Pill DoS 対策）
    function isValidIsoDateString(val) {
      return val is string
        && val.size() <= 40
        && val.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[T ]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):?[0-5][0-9])?$');
    }

    function isValidBlockDoc(blockedId) {
      let d = request.resource.data;
      return blockedId.size() >= 1
        && blockedId.size() <= 128
        && d.keys().hasOnly(['targetName', 'createdAt'])
        && (!('targetName' in d) || (d.targetName is string && d.targetName.size() <= 1000))
        && (!('createdAt' in d) || d.createdAt is timestamp);
    }

    // ==========================================================
    // サーバー専用コレクション（クライアントアクセス完全拒否 / 監査読み取りのみ）
    // ==========================================================
    match /university_email_locks/{lockId} {
      allow read, write: if false;
    }

    match /_account_deletions/{uid} {
      allow read, write: if false;
    }

    match /_admin_alert_rate_limits/{docId} {
      allow read, write: if false;
    }

    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ==========================================================
    // users コレクション
    // ==========================================================
    match /users/{userId} {
      // users プロフィール各フィールドの型・サイズ・Storageオーナースコープ検証（未変更・trim一致の既存レガシー値・要素は維持許容）
      function isValidUserUpdateFields(d) {
        return (isUnchangedField('name') || d.get('name', null) == null || (d.name is string && d.name.size() <= 100) || isTrimmedPrev(d.get('name', null), resource.data.get('name', null)))
          && (isUnchangedField('faculty') || d.get('faculty', null) == null || (d.faculty is string && d.faculty.size() <= 100) || isTrimmedPrev(d.get('faculty', null), resource.data.get('faculty', null)))
          && (isUnchangedField('grade') || d.get('grade', null) == null || (d.grade is int && d.grade >= 1 && d.grade <= 10))
          && (isUnchangedField('mainCampus') || d.get('mainCampus', null) == null || isValidCampus(d.mainCampus))
          && (isUnchangedField('interests') || d.get('interests', null) == null || isValidInterestList(d.interests))
          && (isUnchangedField('iconUrl') || d.get('iconUrl', null) == null || isScopedUserImageUrl(d.iconUrl, userId))
          && (isUnchangedField('photoUrls') || d.get('photoUrls', null) == null || isValidUserPhotoUrlListOnUpdate(d.photoUrls, userId));
      }

      // 本人・承認済み団体・管理者のみ閲覧可能
      allow get: if isAdmin() || isOwner(userId) || isVerifiedOrg();
      allow list: if isAdmin() || isVerifiedOrg();

      // createは本人のみ可能。初期状態は未認証（isStudentVerified == false）の最小フィールドに限定し、
      // 未認証アカウントがプロフィール名を設定して学生一覧に混入することや再create認証バイパスを防ぐ
      allow create: if isOwner(userId)
        && !exists(/databases/$(database)/documents/organizations/$(userId))
        && request.resource.data.keys().hasOnly(['isStudentVerified', 'createdAt'])
        && request.resource.data.get('isStudentVerified', false) == false
        && (!('isStudentVerified' in request.resource.data) || request.resource.data.isStudentVerified is bool)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp);

      // updateは大学メール認証済みの本人のみ可能。変更可能キーをプロフィール項目のみに限定し、
      // サーバー管理フィールドの改ざん・未知キー混入・型破壊（Poison Pill DoS）を防ぐ
      allow update: if isOwner(userId)
        && isVerifiedStudent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'faculty', 'grade', 'mainCampus',
             'interests', 'iconUrl', 'photoUrls'
           ])
        && isValidUserUpdateFields(request.resource.data);

      allow delete: if isAdmin() || isOwner(userId);

      // ── privateサブコレクション（認証メタデータ・大学メール等） ──
      match /private/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // ── blocks サブコレクション（学生がブロックした団体） ──
      match /blocks/{blockedId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create: if isOwner(userId)
          && isVerifiedStudent()
          && blockedId != userId
          && isValidBlockDoc(blockedId);
        allow delete: if isAdmin() || isOwner(userId);
        allow update: if false;
      }
    }

    // ==========================================================
    // organizations コレクション
    // ==========================================================
    match /organizations/{docId} {
      // create 時のプロフィール項目検証（resource が null のため既存値比較は行わず、全項目に現行バリデーションを適用）
      function isValidOrgCreateFields(d) {
        return (!('id' in d) || d.id == null || (d.id is string && d.id == docId))
          && ('name' in d && d.name is string && d.name.size() >= 1 && d.name.size() <= 100)
          && (!('description' in d) || d.description == null || (d.description is string && d.description.size() <= 2000))
          && (!('categories' in d) || d.categories == null || isValidOrgCategoryList(d.categories))
          && (!('campus' in d) || d.campus == null || isValidCampus(d.campus))
          && (!('logoEmoji' in d) || d.logoEmoji == null || (d.logoEmoji is string && d.logoEmoji.size() <= 20))
          && (!('instagramUrl' in d) || d.instagramUrl == null || isValidInstagramUrl(d.instagramUrl))
          && (!('groupLineUrl' in d) || d.groupLineUrl == null || isValidGroupLineUrl(d.groupLineUrl))
          && (!('isOfficial' in d) || d.isOfficial == null || d.isOfficial is bool)
          && (!('createdAt' in d) || d.createdAt == null || d.createdAt is timestamp || isValidIsoDateString(d.createdAt))
          && (!('logoUrl' in d) || d.logoUrl == null || isScopedOrgLogoUrl(d.logoUrl, docId))
          && (!('proofImageUrl' in d) || d.proofImageUrl == null || isScopedOrgProofUrl(d.proofImageUrl, docId))
          && (!('photoUrls' in d) || d.photoUrls == null || isScopedOrgPhotoUrlList(d.photoUrls, docId));
      }

      // update 時のプロフィール項目検証（保存済みの既存レガシー値は未変更または前後空白除去一致で維持を許可し、変更される項目には厳格な検証を適用）
      function isValidOrgUpdateFields(d) {
        return (isUnchangedField('id') || d.get('id', null) == null || (d.id is string && d.id == docId))
          && ('name' in d && d.name is string && (
                d.name == resource.data.get('name', null) ||
                (d.name.size() >= 1 && d.name.size() <= 100) ||
                (d.name.size() >= 1 && isTrimmedPrev(d.name, resource.data.get('name', null)))
              ))
          && (isUnchangedField('description') || d.get('description', null) == null || (d.description is string && d.description.size() <= 2000) || isTrimmedPrev(d.get('description', null), resource.data.get('description', null)))
          && (isUnchangedField('categories') || d.get('categories', null) == null || isValidOrgCategoryList(d.categories))
          && (isUnchangedField('campus') || d.get('campus', null) == null || isValidCampus(d.campus))
          && (isUnchangedField('logoEmoji') || d.get('logoEmoji', null) == null || (d.logoEmoji is string && d.logoEmoji.size() <= 20))
          && (isUnchangedField('instagramUrl') || d.get('instagramUrl', null) == null || isValidInstagramUrl(d.instagramUrl) || isTrimmedPrev(d.get('instagramUrl', null), resource.data.get('instagramUrl', null)))
          && (isUnchangedField('groupLineUrl') || d.get('groupLineUrl', null) == null || isValidGroupLineUrl(d.groupLineUrl) || isTrimmedPrev(d.get('groupLineUrl', null), resource.data.get('groupLineUrl', null)))
          && (isUnchangedField('logoUrl') || d.get('logoUrl', null) == null || isScopedOrgLogoUrl(d.logoUrl, docId))
          && (isUnchangedField('proofImageUrl') || d.get('proofImageUrl', null) == null || isScopedOrgProofUrl(d.proofImageUrl, docId))
          && (isUnchangedField('photoUrls') || d.get('photoUrls', null) == null || isValidOrgPhotoUrlListOnUpdate(d.photoUrls, docId));
      }

      // 個別取得:
      // - 管理者・docId本人（AuthNotifier._resolveUserStatus での存在確認を含む）・代表者本人
      // - 承認済み団体は「認証済み学生」または「承認済み団体」のみ閲覧可（未認証アカウントを遮断）
      allow get: if isAdmin()
        || isOwner(docId)
        || (resource != null && isOwner(resource.data.get('representativeId', '')))
        || (resource != null && resource.data.get('status', '') == 'verified' && (isVerifiedStudent() || isVerifiedOrg()));

      // 一覧取得: 承認済み団体一覧は「認証済み学生」または「承認済み団体」のみ、全件は管理者のみ
      allow list: if isAdmin() ||
        ((isVerifiedStudent() || isVerifiedOrg()) && resource.data.get('status', '') == 'verified');

      // 作成: 自分のUIDをdocIdとし、初期ステータス pending・representativeId=自分・isOfficial=false 固定
      allow create: if isAuthenticated()
        && docId == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['name', 'status', 'representativeId'])
        && request.resource.data.keys().hasOnly([
             'id', 'name', 'description', 'categories', 'campus', 'logoEmoji',
             'instagramUrl', 'groupLineUrl', 'logoUrl', 'representativeId',
             'status', 'proofImageUrl', 'verifiedAt', 'isOfficial',
             'createdAt', 'photoUrls'
           ])
        && request.resource.data.status == 'pending'
        && request.resource.data.representativeId == request.auth.uid
        && (!('verifiedAt' in request.resource.data) || request.resource.data.verifiedAt == null)
        && (!('isOfficial' in request.resource.data) || request.resource.data.isOfficial == false)
        && isValidOrgCreateFields(request.resource.data);

      // 更新: 管理者はステータス変更可能、オーナーはプロフィール項目のみ更新可能（自己承認・公認詐称不可）
      // ※OrgCreateScreen.saveOrganization による申請 update（pending 状態での verifiedAt: null 付与や createdAt 設定）も互換維持する
      allow update: if isAdmin() || (
        (isOwner(docId) || isOwner(resource.data.get('representativeId', '')))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'id', 'name', 'description', 'categories', 'campus', 'logoEmoji',
             'instagramUrl', 'groupLineUrl', 'logoUrl', 'proofImageUrl', 'photoUrls',
             'verifiedAt', 'createdAt'
           ])
        && isUnchangedField('verifiedAt')
        && (isUnchangedField('createdAt') ||
            (resource.data.get('status', '') == 'pending' &&
             (request.resource.data.createdAt is timestamp ||
              isValidIsoDateString(request.resource.data.createdAt))))
        && isValidOrgUpdateFields(request.resource.data)
      );

      // 削除: 管理者または団体オーナー本人
      allow delete: if isAdmin()
        || isOwner(docId)
        || isOwner(resource.data.get('representativeId', ''));

      // ── blocks サブコレクション（団体がブロックした学生） ──
      match /blocks/{blockedId} {
        function isOrgOwner() {
          return isOwner(docId) ||
            (isAuthenticated() &&
             exists(/databases/$(database)/documents/organizations/$(docId)) &&
             get(/databases/$(database)/documents/organizations/$(docId))
               .data.get('representativeId', '') == request.auth.uid);
        }
        allow read: if isAdmin() || isOrgOwner();
        allow create: if isOrgOwner()
          && exists(/databases/$(database)/documents/organizations/$(docId))
          && blockedId != docId
          && isValidBlockDoc(blockedId);
        allow delete: if isAdmin() || isOrgOwner();
        allow update: if false;
      }
    }

    // ==========================================================
    // events コレクション
    // ==========================================================
    match /events/{eventId} {
      function currentOrg() {
        return get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data;
      }

      // 主催団体の正規Storage URL、または主催団体ドキュメントに既に保存されているlogoUrlの転記（レガシー互換）のみ許可
      function isValidEventOrgLogoUrl(url) {
        return isScopedOrgLogoUrl(url, request.auth.uid) ||
          (url is string && url.size() <= 2048 && url == currentOrg().get('logoUrl', null));
      }

      // create 時のイベント項目検証（resource が null のため既存値比較は行わず、全項目に現行バリデーションを適用）
      function isValidEventCreateFields(d) {
        return d.organizationId == request.auth.uid
          && ('title' in d && d.title is string && d.title.size() >= 1 && d.title.size() <= 100)
          && (!('description' in d) || d.description == null || (d.description is string && d.description.size() <= 5000))
          && ('startAt' in d && d.startAt is timestamp)
          && (!('campus' in d) || d.campus == null || isValidCampus(d.campus))
          && (!('organizationEmoji' in d) || d.organizationEmoji == null || (d.organizationEmoji is string && d.organizationEmoji.size() <= 20) ||
              (d.organizationEmoji is string && d.organizationEmoji.size() <= 200 && d.organizationEmoji == currentOrg().get('logoEmoji', null)))
          && (!('organizationCategory' in d) || d.organizationCategory == null || (d.organizationCategory is string && d.organizationCategory.size() <= 30))
          && (!('fee' in d) || d.fee == null || (d.fee is string && d.fee.size() <= 200))
          && (!('capacity' in d) || d.capacity == null || (d.capacity is string && d.capacity.size() <= 200))
          && (!('location' in d) || d.location == null || (d.location is string && d.location.size() <= 500))
          && (!('groupLineUrl' in d) || d.groupLineUrl == null || isValidGroupLineUrl(d.groupLineUrl))
          && (!('updatedAt' in d) || d.updatedAt == null || d.updatedAt is timestamp);
      }

      // update 時のイベント項目検証（保存済みの既存レガシー値は未変更または前後空白除去一致で維持を許可し、変更される項目には厳格な検証を適用）
      function isValidEventUpdateFields(d) {
        return d.organizationId == request.auth.uid
          && ('title' in d && d.title is string && (
                d.title == resource.data.get('title', null) ||
                (d.title.size() >= 1 && d.title.size() <= 100) ||
                (d.title.size() >= 1 && isTrimmedPrev(d.title, resource.data.get('title', null)))
              ))
          && (isUnchangedField('description') || d.get('description', null) == null || (d.description is string && d.description.size() <= 5000) || isTrimmedPrev(d.get('description', null), resource.data.get('description', null)))
          && ('startAt' in d && d.startAt is timestamp)
          && (isUnchangedField('campus') || d.get('campus', null) == null || isValidCampus(d.campus))
          && (isUnchangedField('organizationEmoji') || d.get('organizationEmoji', null) == null ||
              (d.organizationEmoji is string && d.organizationEmoji.size() <= 20) ||
              (d.organizationEmoji is string && d.organizationEmoji.size() <= 200 && d.organizationEmoji == currentOrg().get('logoEmoji', null)))
          && (isUnchangedField('organizationCategory') || d.get('organizationCategory', null) == null || (d.organizationCategory is string && d.organizationCategory.size() <= 30))
          && (isUnchangedField('fee') || d.get('fee', null) == null || (d.fee is string && d.fee.size() <= 200) || isTrimmedPrev(d.get('fee', null), resource.data.get('fee', null)))
          && (isUnchangedField('capacity') || d.get('capacity', null) == null || (d.capacity is string && d.capacity.size() <= 200) || isTrimmedPrev(d.get('capacity', null), resource.data.get('capacity', null)))
          && (isUnchangedField('location') || d.get('location', null) == null || (d.location is string && d.location.size() <= 500) || isTrimmedPrev(d.get('location', null), resource.data.get('location', null)))
          && (isUnchangedField('groupLineUrl') || d.get('groupLineUrl', null) == null || isValidGroupLineUrl(d.groupLineUrl) || isTrimmedPrev(d.get('groupLineUrl', null), resource.data.get('groupLineUrl', null)))
          && (isUnchangedField('updatedAt') || d.get('updatedAt', null) == null || d.updatedAt is timestamp);
      }

      // 閲覧: 管理者・認証済み学生・承認済み団体、または主催団体本人（審査中/却下団体のダッシュボード互換）
      allow read: if isAdmin()
        || isVerifiedStudent()
        || isVerifiedOrg()
        || (isAuthenticated() && resource.data.organizationId == request.auth.uid);

      // 作成: 審査承認済みの団体のみ。過去日時の隠しイベント作成および団体名詐称・未登録外部ロゴURL注入を禁止
      allow create: if isVerifiedOrg()
        && request.resource.data.keys().hasAll(['organizationId', 'title', 'startAt'])
        && request.resource.data.keys().hasOnly([
             'organizationId', 'organizationName', 'organizationEmoji',
             'organizationCategory', 'categories', 'title', 'description',
             'startAt', 'campus', 'organizationLogoUrl', 'fee', 'capacity',
             'location', 'groupLineUrl', 'createdAt', 'updatedAt'
           ])
        && isValidEventCreateFields(request.resource.data)
        && (!('categories' in request.resource.data) || request.resource.data.categories == null || isValidOrgCategoryList(request.resource.data.categories))
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == null || request.resource.data.createdAt is timestamp)
        && (!('organizationLogoUrl' in request.resource.data) ||
            request.resource.data.organizationLogoUrl == null ||
            isValidEventOrgLogoUrl(request.resource.data.organizationLogoUrl))
        && request.resource.data.startAt > request.time - duration.value(15, 'm')
        && (!('organizationName' in request.resource.data) ||
            request.resource.data.organizationName == currentOrg().get('name', ''));

      // 更新: 主催団体（承認済み）のみ。
      // - 未来イベントを過去日時へ巻き戻す行為は禁止しつつ、EventEditScreen の TimeOfDay 変換による秒・ミリ秒切り捨て（最大60秒）を許容
      // - organizationName 欠落・nullの旧イベント更新時は Event.fromFirestore のフォールバック値 'Unknown' も許容
      allow update: if isVerifiedOrg()
        && resource.data.organizationId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'organizationName', 'organizationEmoji', 'organizationCategory',
             'categories', 'title', 'description', 'startAt', 'campus',
             'organizationLogoUrl', 'fee', 'capacity', 'location',
             'groupLineUrl', 'updatedAt'
           ])
        && isValidEventUpdateFields(request.resource.data)
        && (!('categories' in request.resource.data) ||
            request.resource.data.categories == null ||
            request.resource.data.categories == resource.data.get('categories', null) ||
            isValidOrgCategoryList(request.resource.data.categories))
        && (!('organizationLogoUrl' in request.resource.data) ||
            request.resource.data.organizationLogoUrl == null ||
            request.resource.data.organizationLogoUrl == resource.data.get('organizationLogoUrl', null) ||
            isValidEventOrgLogoUrl(request.resource.data.organizationLogoUrl))
        && (request.resource.data.startAt > request.time - duration.value(15, 'm') ||
            ('startAt' in resource.data &&
             resource.data.startAt is timestamp &&
             request.resource.data.startAt >= resource.data.startAt - duration.value(1, 'm')))
        && (!('organizationName' in request.resource.data) ||
            request.resource.data.organizationName == currentOrg().get('name', '') ||
            request.resource.data.organizationName == (resource.data.get('organizationName', null) == null ? 'Unknown' : resource.data.organizationName));

      allow delete: if isAdmin() ||
        (isVerifiedOrg() && resource.data.organizationId == request.auth.uid);

      // ── イベント申し込み（applications サブコレクション） ──
      match /applications/{applicationId} {
        function isEventOrganizer() {
          return isAuthenticated()
            && exists(/databases/$(database)/documents/events/$(eventId))
            && get(/databases/$(database)/documents/events/$(eventId)).data.organizationId == request.auth.uid;
        }

        function currentStudentData() {
          return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        }

        // 本人の正規Storage URL、または本人ドキュメントに既に保存されているiconUrlの転記（レガシー互換）のみ許可
        function isValidApplicationStudentIconUrl(url) {
          return isScopedUserImageUrl(url, request.auth.uid) ||
            (url is string && url.size() <= 2048 && url == currentStudentData().get('iconUrl', null));
        }

        function isValidApplicationCreate() {
          let d = request.resource.data;
          let student = currentStudentData();
          return d.keys().hasAll([
                   'studentId', 'studentName', 'studentFaculty',
                   'studentGrade', 'status', 'appliedAt'
                 ])
            && d.keys().hasOnly([
                 'studentId', 'studentName', 'studentFaculty',
                 'studentGrade', 'studentIconUrl', 'status', 'appliedAt'
               ])
            && d.studentId == request.auth.uid
            && d.studentName is string && d.studentName.size() <= 1000
            && ((d.studentName.size() >= 1 && d.studentName.size() <= 100) || d.studentName == student.get('name', null))
            && d.studentFaculty is string && d.studentFaculty.size() <= 1000
            && ((d.studentFaculty.size() >= 1 && d.studentFaculty.size() <= 100) || d.studentFaculty == student.get('faculty', null))
            && d.studentGrade is int && ((d.studentGrade >= 1 && d.studentGrade <= 10) || d.studentGrade == student.get('grade', null))
            && (!('studentIconUrl' in d) || d.studentIconUrl == null || isValidApplicationStudentIconUrl(d.studentIconUrl))
            && d.status == 'applied'
            && d.appliedAt is timestamp;
        }

        // 読み取り: 大学メール認証済みの申込本人、イベント主催団体、または管理者
        allow get: if isAdmin()
          || (isVerifiedStudent() && request.auth.uid == applicationId)
          || isEventOrganizer();

        // 一覧取得: イベント主催団体または管理者のみ
        allow list: if isAdmin() || isEventOrganizer();

        // 作成: 大学メール認証済みの学生のみ（未認証アカウントによる偽装申込を遮断）
        allow create: if isVerifiedStudent()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && applicationId == request.auth.uid
          && isValidApplicationCreate();

        // 更新: 主催団体（承認済み）が status と respondedAt のみ変更可能
        allow update: if isVerifiedOrg()
          && isEventOrganizer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['applied', 'accepted', 'rejected']
          && (!('respondedAt' in request.resource.data) || request.resource.data.respondedAt is timestamp);

        // 削除: 申し込んだ学生本人（キャンセル）、イベント主催団体、管理者
        allow delete: if isAdmin() || (isAuthenticated() && (
          request.auth.uid == applicationId ||
          isEventOrganizer()
        ));
      }
    }

    // ==========================================================
    // scouts コレクション
    // ==========================================================
    match /scouts/{docId} {
      function senderOrg() {
        return get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data;
      }

      function scoutTarget() {
        return get(/databases/$(database)/documents/users/$(request.resource.data.targetUserId)).data;
      }

      function pickedEvent() {
        return get(/databases/$(database)/documents/events/$(request.resource.data.templateEventId)).data;
      }

      function isNotBlockedByTarget() {
        return !exists(/databases/$(database)/documents/users/$(request.resource.data.targetUserId)/blocks/$(request.auth.uid));
      }

      function isValidScoutTargetAndPayload(d, org) {
        let target = scoutTarget();
        let orgInsta = org.get('instagramUrl', null) == null ? '' : org.instagramUrl;
        let orgLine = org.get('groupLineUrl', null) == null ? '' : org.groupLineUrl;
        let targetInterests = target.get('interests', null) is list ? target.interests : [];
        let targetCampus = target.get('mainCampus', null) == null ? 'imadegawa' : target.mainCampus;
        let targetGrade = target.get('grade', null) == null ? 1 : target.grade;
        let expectedTargetName = target.get('name', null) == null ? '未設定' : target.name;
        return target.get('isStudentVerified', false) == true
          && d.isRead == false
          && (!('readAt' in d) || d.readAt == null)
          && (!('sentAt' in d) || d.sentAt is timestamp)
          // 団体名・絵文字・対象学生名へのなりすまし・連絡先ID混入（定型文制限バイパス）を禁止し、登録実データとの一致を強制
          && (!('organizationName' in d) ||
              (d.organizationName is string && d.organizationName.size() >= 1 && d.organizationName.size() <= 1000 && d.organizationName == org.get('name', '')))
          && (!('organizationEmoji' in d) || d.organizationEmoji == null ||
              (d.organizationEmoji is string && d.organizationEmoji.size() <= 200 &&
               ((org.get('logoEmoji', null) == null && d.organizationEmoji.size() <= 20) || d.organizationEmoji == org.get('logoEmoji', null))))
          && (!('organizationCategory' in d) || (d.organizationCategory is string && d.organizationCategory.size() <= 50))
          // URLのフィッシング・裏連絡先すり替え・外部IPロガー対策
          // 送信元団体・対象学生の登録値との完全一致を強制する（instagramUrl / groupLineUrl の形式検証は organizations 側の新規/変更時に行い、
          // 既に linktr.ee や http:// 等が保存されている既存団体のスカウト送信が止まらないよう再検証は行わない）
          && (!('organizationInstagramUrl' in d) || d.organizationInstagramUrl == null ||
              (d.organizationInstagramUrl is string && d.organizationInstagramUrl.size() <= 2048 && d.organizationInstagramUrl == orgInsta))
          && (!('organizationGroupLineUrl' in d) || d.organizationGroupLineUrl == null || d.organizationGroupLineUrl == '' ||
              (d.organizationGroupLineUrl is string && d.organizationGroupLineUrl.size() <= 2048 && d.organizationGroupLineUrl == orgLine))
          && (!('organizationLogoUrl' in d) || d.organizationLogoUrl == null ||
              (d.organizationLogoUrl is string && d.organizationLogoUrl.size() <= 2048 && d.organizationLogoUrl == org.get('logoUrl', null)))
          && (!('targetUserIconUrl' in d) || d.targetUserIconUrl == null ||
              (d.targetUserIconUrl is string && d.targetUserIconUrl.size() <= 2048 && d.targetUserIconUrl == target.get('iconUrl', null)))
          && (!('targetUserName' in d) || d.targetUserName == null ||
              (d.targetUserName is string && d.targetUserName.size() <= 1000 && d.targetUserName == expectedTargetName))
          && d.templateId is int
          && d.templateId >= 0
          && d.templateId <= 4
          && (
            // 0: 興味タグに共感 → 対象学生が登録しているタグのみ
            (d.templateId == 0
              && d.templateArg is string
              && d.templateArg.size() <= 500
              && d.templateArg in targetInterests)
            // 1: イベントに招待 → 自団体の公開中イベント（過去日時の隠しイベントは不可、時計ズレ15分許容）かつタイトル一致
            || (d.templateId == 1
              && d.templateArg is string
              && d.templateArg.size() <= 500
              && d.templateEventId is string
              && d.templateEventId.size() <= 128
              && exists(/databases/$(database)/documents/events/$(d.templateEventId))
              && pickedEvent().organizationId == request.auth.uid
              && pickedEvent().title == d.templateArg
              && (!('startAt' in pickedEvent()) || pickedEvent().startAt == null ||
                  pickedEvent().startAt > request.time - duration.value(15, 'm')))
            // 2: 同じキャンパス → 対象学生の登録キャンパス（未設定時はUserProfile初期値 'imadegawa'）と一致
            || (d.templateId == 2
              && d.templateArg is string
              && d.templateArg == targetCampus)
            // 3: 学年を歓迎 → 対象学生の学年（未設定時はUserProfile初期値 1）と一致
            || (d.templateId == 3
              && d.templateArg is string
              && d.templateArg == string(targetGrade))
            // 4: 見学のお誘い → 埋め込む値を持たない
            || (d.templateId == 4
              && !d.keys().hasAny(['templateArg', 'templateEventId']))
          );
      }

      function isValidScoutCreate() {
        let d = request.resource.data;
        return d.keys().hasAll(['targetUserId', 'organizationId', 'templateId', 'isRead'])
          && d.keys().hasOnly([
              'targetUserId', 'organizationId', 'organizationName',
              'organizationEmoji', 'organizationCategory',
              'templateId', 'templateArg', 'templateEventId',
              'isRead', 'readAt', 'sentAt',
              'organizationInstagramUrl', 'organizationGroupLineUrl',
              'organizationLogoUrl', 'targetUserIconUrl', 'targetUserName'
             ])
          && d.targetUserId is string
          && d.targetUserId.size() >= 1 && d.targetUserId.size() <= 128
          && exists(/databases/$(database)/documents/users/$(d.targetUserId))
          && isValidScoutTargetAndPayload(d, senderOrg());
      }

      // 読み取りは当事者（認証済み学生または承認済み団体）および管理者のみ
      allow get: if isAdmin() || ((isVerifiedStudent() || isVerifiedOrg()) &&
        (request.auth.uid == resource.data.targetUserId ||
         request.auth.uid == resource.data.organizationId));

      allow list: if isAdmin() || ((isVerifiedStudent() || isVerifiedOrg()) &&
        (request.auth.uid == resource.data.targetUserId ||
         request.auth.uid == resource.data.organizationId));

      // 既読更新は対象学生（認証済み）のみ、isRead と readAt のみ変更可能
      allow update: if isVerifiedStudent()
        && request.auth.uid == resource.data.targetUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
        && request.resource.data.isRead is bool
        && (!('readAt' in request.resource.data) ||
            request.resource.data.readAt == null ||
            request.resource.data.readAt is timestamp);

      // 作成は審査承認済みの団体のみ
      allow create: if isVerifiedOrg()
        && request.resource.data.organizationId == request.auth.uid
        && isNotBlockedByTarget()
        && isValidScoutCreate();

      // 削除は当事者または管理者のみ
      allow delete: if isAdmin() || (isAuthenticated() &&
        (request.auth.uid == resource.data.targetUserId ||
         request.auth.uid == resource.data.organizationId));
    }

    // ==========================================================
    // reports コレクション（通報）
    // ==========================================================
    match /reports/{reportId} {
      function isBoundedStringList(items, maxLen, maxJoinedSize) {
        return items is list
          && items.size() <= maxLen
          && items.join('').size() <= maxJoinedSize;
      }

      // 通報スナップショットの検証:
      // 1MB容量爆弾や未知キー混入は確実に遮断しつつ、ルール導入前の長文・複数画像を持つ
      // 悪質プロフィールを通報しようとした被害者が弾かれないよう十分な上限幅を持たせる
      function isValidReportSnapshot(s) {
        return s is map
          && s.size() <= 20
          && s.keys().hasOnly([
               'name', 'description', 'categories', 'campus', 'instagramUrl',
               'logoUrl', 'photoUrls', 'scoutId', 'organizationName', 'body',
               'templateId', 'templateArg', 'sentAt', 'faculty', 'grade',
               'mainCampus', 'interests', 'iconUrl'
             ])
          && (!('name' in s) || (s.name is string && s.name.size() <= 1000))
          && (!('description' in s) || (s.description is string && s.description.size() <= 10000))
          && (!('body' in s) || (s.body is string && s.body.size() <= 10000))
          && (!('organizationName' in s) || (s.organizationName is string && s.organizationName.size() <= 1000))
          && (!('scoutId' in s) || (s.scoutId is string && s.scoutId.size() <= 128))
          && (!('templateId' in s) || s.templateId == null || s.templateId is int)
          && (!('templateArg' in s) || s.templateArg == null || (s.templateArg is string && s.templateArg.size() <= 500))
          && (!('sentAt' in s) || (s.sentAt is string && s.sentAt.size() <= 60))
          && (!('campus' in s) || (s.campus is string && s.campus.size() <= 100))
          && (!('instagramUrl' in s) || (s.instagramUrl is string && s.instagramUrl.size() <= 2048))
          && (!('logoUrl' in s) || s.logoUrl == null || (s.logoUrl is string && s.logoUrl.size() <= 2048))
          && (!('iconUrl' in s) || s.iconUrl == null || (s.iconUrl is string && s.iconUrl.size() <= 2048))
          && (!('faculty' in s) || (s.faculty is string && s.faculty.size() <= 1000))
          && (!('grade' in s) || s.grade is int)
          && (!('mainCampus' in s) || (s.mainCampus is string && s.mainCampus.size() <= 100))
          && (!('categories' in s) || isBoundedStringList(s.categories, 50, 2000))
          && (!('interests' in s) || isBoundedStringList(s.interests, 100, 5000))
          && (!('photoUrls' in s) || isBoundedStringList(s.photoUrls, 20, 20000));
      }

      function isValidReport() {
        let d = request.resource.data;
        return d.keys().hasAll([
                 'reporterId', 'reporterRole', 'targetType', 'targetId',
                 'targetName', 'reason', 'detail', 'status', 'createdAt'
               ])
          && d.keys().hasOnly([
               'reporterId', 'reporterRole', 'targetType', 'targetId',
               'targetName', 'reason', 'detail', 'snapshot', 'status', 'createdAt'
             ])
          && d.reporterId == request.auth.uid
          && d.targetId is string && d.targetId.size() >= 1 && d.targetId.size() <= 128
          && d.targetId != request.auth.uid
          // 旧スカウト等で organizationName が空文字の場合も、レガシー長文団体名の場合も通報できるよう許容
          && d.targetName is string && d.targetName.size() <= 1000
          && ((d.reporterRole == 'student' && isVerifiedStudent()) ||
              (d.reporterRole == 'organization' && isVerifiedOrg()))
          && d.targetType in ['user', 'organization']
          && d.reason in ['inappropriate_content', 'impersonation',
                          'harassment', 'dating', 'spam', 'other']
          && d.detail is string
          && d.detail.size() <= 1000
          && (!('snapshot' in d) || isValidReportSnapshot(d.snapshot))
          && d.status == 'open'
          && d.createdAt is timestamp;
      }

      allow create: if isAuthenticated() && isValidReport();
      allow read, update, delete: if isAdmin();
    }

    // ==========================================================
    // contacts コレクション（お問い合わせ）
    // ==========================================================
    match /contacts/{docId} {
      function isValidContact() {
        let d = request.resource.data;
        return d.keys().hasAll(['userId', 'category', 'message', 'status', 'createdAt'])
          && d.keys().hasOnly(['userId', 'category', 'message', 'status', 'createdAt'])
          && d.userId == request.auth.uid
          && d.category in ['バグ報告', '機能要望', '使い方がわからない', 'その他']
          && d.message is string
          && d.message.size() >= 1
          && d.message.size() <= 2000
          && d.status == 'open'
          && d.createdAt is timestamp;
      }

      allow create: if (isVerifiedStudent() || isOrgAccount() || isAdmin())
        && isValidContact();
      allow read, update, delete: if isAdmin();
    }

    // ==========================================================
    // tags コレクション（タグマスタ）
    // ==========================================================
    match /tags/{docId} {
      function isValidTag() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'createdAt'])
          && d.keys().hasOnly(['name', 'createdAt'])
          && d.name is string
          && d.name.size() >= 1
          && d.name.size() <= 100
          && d.createdAt is timestamp;
      }

      // 認証済み学生・団体・管理者が読み取り可能
      allow read: if isAdmin() || isVerifiedStudent() || isOrgAccount();
      // 認証済み学生（マイページの興味タグ追加）・承認済み団体・管理者が作成可能
      allow create: if (isVerifiedStudent() || isVerifiedOrg() || isAdmin())
        && isValidTag();
      allow update, delete: if isAdmin();
    }
  }
}
