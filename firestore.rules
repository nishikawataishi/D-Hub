rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================================
    // ヘルパー関数
    // ==========================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.admin == true;
    }

    // 呼び出し元の団体が審査承認済みかチェック
    function isVerifiedOrg() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.status == 'verified';
    }

    // ==========================================================
    // users コレクション
    // ==========================================================
    match /users/{userId} {
      // 本人・承認済み団体・管理者のみ閲覧可能
      allow get: if isOwner(userId) || isVerifiedOrg() || isAdmin();
      allow list: if isVerifiedOrg() || isAdmin();
      // updateは本人のみ可能。ただしサーバー管理フィールドは変更不可
      // （レート制限カウンタ・大学メール等の自己改ざん防止を含む）
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['isStudentVerified', 'verificationCode', 'codeExpiresAt', 'verifiedAt',
           'verificationAttempts', 'lastCodeSentAt', 'codeHashedValue',
           'codeSentCount', 'codeSentWindowStart', 'universityEmail', 'email']
        );
      // createは本人のみ可能。ただし認証済み状態やサーバー管理フィールドを
      // 持ったドキュメントは作成不可（delete→再createによる学生認証バイパス対策）
      allow create: if isOwner(userId) &&
        request.resource.data.get('isStudentVerified', false) == false &&
        !request.resource.data.keys().hasAny(
          ['verificationCode', 'codeExpiresAt', 'verifiedAt',
           'verificationAttempts', 'lastCodeSentAt', 'codeHashedValue',
           'codeSentCount', 'codeSentWindowStart', 'universityEmail']
        );
      allow delete: if isOwner(userId) || isAdmin();

      // ── privateサブコレクション（認証メタデータ・大学メール等） ──
      // Cloud Function（Admin SDK）のみが読み書きする。クライアントからは
      // 管理者の読み取り以外一切アクセス不可（団体への個人情報露出防止）
      match /private/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // ── blocks サブコレクション（学生がブロックした団体） ──
      // ドキュメントIDはブロックした団体のUID。本人だけが読み書きでき、
      // ブロックされた側からは参照できない（利用規約 第8条3）。
      // 運営は通報対応の調査のために読み取れる。
      match /blocks/{blockedId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && blockedId != userId;
        allow delete: if isOwner(userId);
        allow update: if false;
      }
    }

    match /organizations/{docId} {
      // 個別ドキュメント取得: 承認済みは誰でも、申請中/却下は作成者本人 or 管理者
      allow get: if isAdmin() || (isAuthenticated() && (
        resource.data.status == 'verified' ||
        isOwner(resource.data.representativeId) ||
        isOwner(docId) // 後方互換性：docIdがUIDの場合
      ));
      // コレクションクエリ: 承認済み団体の一覧は全認証ユーザー、全件は管理者のみ
      allow list: if isAdmin() || isAuthenticated();

      // 作成は認証済みユーザーなら誰でも可能だが、初期ステータスは pending 固定
      allow create: if isAuthenticated() &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.representativeId == request.auth.uid;

      // 更新：管理者はステータス変更可能、オーナーは審査関連フィールド以外を変更可能
      // （statusを他フィールドと同時に更新しても自己承認できないよう hasAny で禁止）
      allow update: if isAdmin() ||
                    ((isOwner(resource.data.representativeId) || isOwner(docId)) &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                      ['status', 'verifiedAt', 'representativeId']
                    ));

      // 削除：管理者または団体オーナー本人（退会処理用）
      allow delete: if isAdmin() ||
                    isOwner(resource.data.representativeId) ||
                    isOwner(docId);

      // ── blocks サブコレクション（団体がブロックした学生） ──
      // ドキュメントIDはブロックした学生のUID。団体オーナーだけが読み書きでき、
      // ブロックされた学生からは参照できない（利用規約 第8条3）。
      match /blocks/{blockedId} {
        function isOrgOwner() {
          return isOwner(docId) ||
            (isAuthenticated() &&
             get(/databases/$(database)/documents/organizations/$(docId))
               .data.representativeId == request.auth.uid);
        }
        allow read: if isOrgOwner() || isAdmin();
        allow create: if isOrgOwner() && blockedId != docId;
        allow delete: if isOrgOwner();
        allow update: if false;
      }
    }

    // ==========================================================
    // events コレクション
    // ==========================================================
    match /events/{eventId} {
      allow read: if isAuthenticated();
      // 団体UID制限: 審査承認済みの団体のみ作成・更新・削除可能
      allow create: if isVerifiedOrg() && request.resource.data.organizationId == request.auth.uid;
      allow update: if isVerifiedOrg()
                    && resource.data.organizationId == request.auth.uid
                    && request.resource.data.organizationId == request.auth.uid;
      allow delete: if isVerifiedOrg() && resource.data.organizationId == request.auth.uid;

      // ── イベント申し込み（applications サブコレクション） ──
      match /applications/{applicationId} {
        // 読み取り: 申し込んだ学生本人 または イベント主催団体
        allow get: if isAuthenticated() && (
          request.auth.uid == applicationId ||
          get(/databases/$(database)/documents/events/$(eventId)).data.organizationId == request.auth.uid
        );
        // 一覧取得: イベント主催団体のみ（学生は自分の申し込みは get で取得）
        allow list: if isAuthenticated() &&
          get(/databases/$(database)/documents/events/$(eventId)).data.organizationId == request.auth.uid;

        // 作成: 認証済み学生のみ。docIDは自分のUID固定で1人1申し込みを保証。初期ステータスは applied 固定
        allow create: if isAuthenticated()
                      && applicationId == request.auth.uid
                      && request.resource.data.studentId == request.auth.uid
                      && request.resource.data.status == 'applied';

        // 更新: 主催団体がステータスと respondedAt のみ変更可能
        allow update: if isAuthenticated()
                      && get(/databases/$(database)/documents/events/$(eventId)).data.organizationId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);

        // 削除: 申し込んだ学生本人（キャンセル）、イベント主催団体、管理者。
        // 主催団体を含めるのは、団体がイベントを消したときに applications が
        // 孤児として残るのを防ぐため（サブコレクションは親を消しても残る）。
        // ⚠️ 主催団体判定は events ドキュメントを参照するので、イベント本体より
        // 先に applications を消すこと。順序を逆にすると参照先が消えて拒否される。
        allow delete: if isAdmin() || (isAuthenticated() && (
          request.auth.uid == applicationId ||
          get(/databases/$(database)/documents/events/$(eventId)).data.organizationId == request.auth.uid
        ));
      }
    }

    // ==========================================================
    // scouts コレクション
    // ==========================================================
    match /scouts/{docId} {
      // ── 定型文スカウトの検証（自由記述の禁止） ──
      // 団体は本文を自由に書けず、5種類の定型文から選ぶ。埋め込む値も
      // 「対象学生が実際に登録している値」または「自団体が実際に公開している
      // イベント」と一致していなければ保存できない。これにより自由記述は
      // 運用ルールではなくシステム上の制約として排除される。

      function scoutTarget() {
        return get(/databases/$(database)/documents/users/$(request.resource.data.targetUserId)).data;
      }

      function pickedEvent() {
        return get(/databases/$(database)/documents/events/$(request.resource.data.templateEventId)).data;
      }

      // 送信先の学生が送信元の団体をブロックしていないこと。
      // 「ブロックした団体からはスカウトが届かない」（利用規約 第8条2）を
      // クライアントの実装ではなくルールで保証する。
      function isNotBlockedByTarget() {
        return !exists(/databases/$(database)/documents/users/$(request.resource.data.targetUserId)/blocks/$(request.auth.uid));
      }

      function isValidScoutTemplate() {
        let d = request.resource.data;
        return d.templateId is int
          && d.templateId >= 0
          && d.templateId <= 4
          // 想定外のフィールドを一切許可しない（旧形式の message もここで弾かれる）
          && d.keys().hasOnly([
              'targetUserId', 'organizationId', 'organizationName',
              'organizationEmoji', 'organizationCategory',
              'templateId', 'templateArg', 'templateEventId',
              'isRead', 'readAt', 'sentAt',
              'organizationInstagramUrl', 'organizationGroupLineUrl',
              'organizationLogoUrl', 'targetUserIconUrl', 'targetUserName'
             ])
          && (
            // 0: 興味タグに共感 → 対象学生が登録しているタグのみ
            (d.templateId == 0
              && d.templateArg is string
              && d.templateArg in scoutTarget().get('interests', []))
            // 1: イベントに招待 → 自団体のイベントで、タイトルが実物と一致すること
            || (d.templateId == 1
              && d.templateArg is string
              && d.templateEventId is string
              && exists(/databases/$(database)/documents/events/$(d.templateEventId))
              && pickedEvent().organizationId == request.auth.uid
              && pickedEvent().title == d.templateArg)
            // 2: 同じキャンパス → 対象学生の登録キャンパスと一致
            || (d.templateId == 2
              && d.templateArg is string
              && d.templateArg == scoutTarget().get('mainCampus', ''))
            // 3: 学年を歓迎 → 対象学生の学年と一致
            || (d.templateId == 3
              && d.templateArg is string
              && d.templateArg == string(scoutTarget().get('grade', 0)))
            // 4: 見学のお誘い → 埋め込む値を持たない
            || (d.templateId == 4
              && !d.keys().hasAny(['templateArg', 'templateEventId']))
          );
      }

      // 読み取りはスカウト対象の学生、または送信元の団体のみ
      allow get: if isAuthenticated() &&
        (request.auth.uid == resource.data.targetUserId ||
         request.auth.uid == resource.data.organizationId);
      // listクエリは当事者（スカウト対象の学生 or 送信元団体）のみ。
      // クライアントのクエリはwhere条件で自分のUIDを指定している必要がある
      allow list: if isAdmin() || (isAuthenticated() &&
        (request.auth.uid == resource.data.targetUserId ||
         request.auth.uid == resource.data.organizationId));

      // 更新（既読フラグなど）は対象学生のみ、かつisReadとreadAtのみ更新可能
      allow update: if isAuthenticated()
                    && request.auth.uid == resource.data.targetUserId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);

      // 作成は審査承認済みの団体のみ。本文は定型文に限定され、自由記述はできない
      allow create: if isVerifiedOrg()
                    && request.resource.data.organizationId == request.auth.uid
                    && isNotBlockedByTarget()
                    && isValidScoutTemplate();

      // 削除は当事者（スカウト対象の学生 or 送信元団体）と管理者のみ。
      // delete ルールが無いと退会時にスカウトが消せず、学生名やLINE URLを含む
      // レコードが残り続ける（規約第14条2に違反する）。管理者も消せなかった。
      allow delete: if isAdmin() || (isAuthenticated() &&
        (request.auth.uid == resource.data.targetUserId ||
         request.auth.uid == resource.data.organizationId));
    }

    // ==========================================================
    // reports コレクション（通報）
    // ==========================================================
    // 利用規約 第7条に基づく通報。通報内容と対象コンテンツのスナップショットは
    // 運営のみが確認する（第7条2）。通報者が誰かは通報された相手に開示されない
    // ため、read は管理者に限定し、通報者自身にも読ませない（第7条4）。
    match /reports/{reportId} {
      function isValidReport() {
        let d = request.resource.data;
        return d.keys().hasAll([
                 'reporterId', 'reporterRole', 'targetType', 'targetId',
                 'targetName', 'reason', 'detail', 'status'
               ])
          && d.keys().hasOnly([
               'reporterId', 'reporterRole', 'targetType', 'targetId',
               'targetName', 'reason', 'detail', 'snapshot', 'status', 'createdAt'
             ])
          && d.reporterId == request.auth.uid
          // 自分自身は通報できない（自作自演で運営工数を消費させない）
          && d.targetId != request.auth.uid
          && d.reporterRole in ['student', 'organization']
          && d.targetType in ['user', 'organization']
          && d.reason in ['inappropriate_content', 'impersonation',
                          'harassment', 'dating', 'spam', 'other']
          && d.detail is string
          && d.detail.size() <= 1000
          && d.status == 'open';
      }

      allow create: if isAuthenticated() && isValidReport();
      allow read, update, delete: if isAdmin();
    }

    // ==========================================================
    // contacts コレクション（お問い合わせ）
    // ==========================================================
    match /contacts/{docId} {
      // 作成: 認証済みユーザーが自分のUIDを含む問い合わせのみ送信可能
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid;
      // 読み取り・更新・削除: 管理者のみ
      allow read, update, delete: if isAdmin();
    }

    // ==========================================================
    // tags コレクション（タグマスタ）
    // ==========================================================
    match /tags/{docId} {
      // 認証済みユーザーなら誰でも読み取り可能
      allow read: if isAuthenticated();
      // タグの追加は承認済み団体または管理者のみ
      allow create: if isVerifiedOrg() || isAdmin();
      // 削除は管理者のみ
      allow delete: if isAdmin();
      // 更新は管理者のみ
      allow update: if isAdmin();
    }
  }
}
