# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase configs (Security/Privacy)
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# Env vars
.env

# iOS 署名資材（絶対にコミットしない）
# 秘密鍵・証明書・プロビジョニングプロファイル・App Store Connect API キー。
# これらは GitHub Secrets にだけ置く。ローカルの実体は ios/certs/ に集約する。
ios/certs/
*.p12
*.p8
*.cer
*.pem
*.certSigningRequest
*.mobileprovision

# fastlane / iOS ビルド生成物
# ios/Gemfile.lock は「コミットする」。package-lock.json と同じ理由で
# fastlane とその依存のバージョンを固定するため、ignore しない。
ios/build/
ios/vendor/
ios/.bundle/
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/test_output/
ios/fastlane/README.md

# Analysis and logs
analyze*.txt
deploy_res.txt
error.log
emulator.log
lint_results.txt
analyze_*.txt
*.log
debug_out.txt
emulator_log.txt

# Node.js
node_modules/
functions/node_modules/
# package-lock.json は「コミットする」。バージョンを固定することが
# npmサプライチェーン攻撃（侵害版は数時間で削除されることが多い）への
# 最も基本的な防御になるため、ignore しない。

# Firebase cache
.firebase/

# Claude Code local files
.claude/

# Large binaries / JDK
jdk-*/
*.zip
*.tar.gz

# Miscellaneous local files
sp-*.png
scripts/

# Firestore emulator logs
firestore-debug.log
firebase-debug.log
ui-debug.log
